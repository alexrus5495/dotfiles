* {
    background: rgba(41, 49, 58, 0.7);
    primary: #b3c9e3;
    primary-fixed: #cfe5ff;
    primary-fixed-dim: #b3c9e3;
    on-primary: #1c3247;
    on-primary-fixed: #051d31;
    on-primary-fixed-variant: #34495e;
    primary-container: #4d6279;
    on-primary-container: #ffffff;
    secondary: #bfc7d3;
    secondary-fixed: #dbe3ef;
    secondary-fixed-dim: #bfc7d3;
    on-secondary: #29313a;
    on-secondary-fixed: #151c25;
    on-secondary-fixed-variant: #404751;
    secondary-container: #404751;
    on-secondary-container: #d9e1ed;
    tertiary: #e5c095;
    tertiary-fixed: #ffddb6;
    tertiary-fixed-dim: #e5c095;
    on-tertiary: #422c0c;
    on-tertiary-fixed: #2a1800;
    on-tertiary-fixed-variant: #5b4220;
    tertiary-container: #775b37;
    on-tertiary-container: #ffffff;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #121315;
    on-surface: #e3e2e4;
    on-surface-variant: #c3c6cd;
    outline: #8d9197;
    outline-variant: #43474c;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e3e2e4;
    inverse-on-surface: #303032;
    inverse-primary: #4b6077;
    surface-dim: #121315;
    surface-bright: #38393b;
    surface-container-lowest: #0d0e10;
    surface-container-low: #1b1c1d;
    surface-container: #1f2021;
    surface-container-high: #292a2c;
    surface-container-highest: #343536;
}
